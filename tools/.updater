#!/usr/bin/env zsh

set -eu

declare -r commandName=$(basename "$0")
declare -r -a commandArguments=($@)
declare -r toolsDir=$(cd $(dirname "$0") && pwd -P)
declare -r repoRootDir=$(dirname "$toolsDir")
declare -r imagesDir="${repoRootDir}/images"
declare -r -a gitHubActionsFilePaths=(
  "${repoRootDir}/.github/workflows/build-test-push.yml"
)
declare -a allDockerfilePaths=()

# initialize
function () {
  local dockerfilePath
  for dockerfilePath in "${imagesDir}"/**/*.Dockerfile; do
    if [[ ! -L "$dockerfilePath" ]]; then
      allDockerfilePaths=($allDockerfilePaths $dockerfilePath)
    fi
  done
}

declare -A commonOptions=()
zparseopts -D -E -M -A commonOptions -- -commit

declare doCommit="false"
if [[ -n "${commonOptions[(i)--commit]}" ]]; then
  doCommit="true"
fi

# Misc. functions
######################

function view-note() {
  local -r message="${1-Unknown warning.}"
  print -P "%F{008}note: %f$message" >&2
}

function view-warning() {
  local -r message="${1-Unknown warning.}"
  print -P "%F{yellow}warning: %f$message" >&2
}

function view-error() {
  local -r message="${1-Unknown error.}"
  print -P "%F{red}error: %f$message" >&2
}

function fatal-error() {
  view-error "${1:-}"
  exit 1
}

function isDarwin() {
  if [[ "$(uname -s)" == "Darwin" ]]; then
    function isDarwin() {
      return 0
    }
    return 0
  else
    function isDarwin() {
      return 1
    }
    return 1
  fi
}

function isTrue() {
  local -r booleanValue="${1:-false}"
  if [[ "${(L)booleanValue}" = "true" ]]; then
    return 0
  fi
  return 1
}

function latest-version-tag() {
  local -r -a tagLines=("${(f)1}")

  local latestVersionString="0.0.0"
  local latestMajorVersion=0
  local latestMinorVersion=0
  local latestPatchVersion=0

  local currentVersionString
  local currentMajorVersion
  local currentMinorVersion
  local currentPatchVersion

  local aTagLine
  for aTagLine in $tagLines; do
    if [[ "$aTagLine" =~ ^(v(er\.?))?[[:space:]]*([0-9]+)(\.([0-9]+)(\.([0-9]+))?)?([+].+)?$ ]]; then
      currentVersionString="$aTagLine"
      currentMajorVersion=$(( "${match[3]}" + 0 ))
      currentMinorVersion=$(( "${match[5]:-0}" + 0 ))
      currentPatchVersion=$(( "${match[7]:-0}" + 0 ))

      if [[ $currentMajorVersion -gt $latestMajorVersion ]] || \
         [[ $currentMajorVersion -eq $latestMajorVersion && $currentMinorVersion -gt $latestMinorVersion ]] || \
         [[ $currentMajorVersion -eq $latestMajorVersion && $currentMinorVersion -eq $latestMinorVersion && $currentPatchVersion -gt $latestPatchVersion ]]
      then
        latestVersionString="$currentVersionString"
        latestMajorVersion=$currentMajorVersion
        latestMinorVersion=$currentMinorVersion
        latestPatchVersion=$currentPatchVersion
      fi
    fi
  done

  if [[ $latestMajorVersion -eq 0 && $latestMinorVersion -eq 0 && $latestPatchVersion -eq 0 ]]; then
    return 1
  fi
  echo "$latestVersionString"
}

declare -A __repositories=()
function tags-of-remote-repository() {
  local -r repoURL="$1"

  if [[ -z "${__repositories[$repoURL]:-}" ]]; then
    local -r localRepoPath="$(mktemp -d)"
    cd "$localRepoPath"
    git init
    git remote add origin "$repoURL"
    __repositories[$repoURL]="$localRepoPath"
  fi

  cd "${__repositories[$repoURL]}"

  {
    local tagLine
    local tagRef
    local -r lightweightTagRegex='^(.+)\^\{\}$'
    while IFS= read -r tagLine; do
      if [[ "$tagLine" =~ refs/tags/(.+)$ ]]; then
        tagRef="${match[1]}"
        if [[ "$tagRef" =~ $lightweightTagRegex ]]; then
          echo "${match[1]}"
        else
          echo "$tagRef"
        fi
      fi
    done < <(git ls-remote --tags)
  } | sort -u
}

function sed-in-place() {
  local -r aScript="$1"
  local -r aFilePath="$2"

  if isDarwin; then
    set -x
    sed -i '' -E "$aScript" "$aFilePath"
    { set +x; } 2>/dev/null
  else
    set -x
    sed -i -E "$aScript" "$aFilePath"
    { set +x; } 2>/dev/null
  fi
}

function sed-all-GA-files() {
  local -r sedScript="$1"
  local gaPath
  for gaPath in $gitHubActionsFilePaths; do
    sed-in-place "$sedScript" "$gaPath"
  done
}

function sed-all-dockerfiles() {
  local -r sedScript="$1"
  local dockerfilePath
  for dockerfilePath in $allDockerfilePaths; do
    sed-in-place "$sedScript" "$dockerfilePath"
  done
}

function replace-value-for-key-in-all-GA-files() {
  local -r theValue="$1"
  local -r theKey="$2"
  sed-all-GA-files "s/${theKey}:[[:space:]]+\".*\"/${theKey}: \"${theValue}\"/g"
}

function replace-value-for-key-in-all-dockerfiles() {
  local -r theValue="$1"
  local -r theKey="$2"
  sed-all-dockerfiles "s/ARG[[:space:]]+${theKey}=\".*\"/ARG ${theKey}=\"${theValue}\"/g"
}

function replace-value-for-key-in-all-files() {
  local -r theValue="$1"
  local -r theKey="$2"
  replace-value-for-key-in-all-GA-files "$theValue" "$theKey"
  replace-value-for-key-in-all-dockerfiles "$theValue" "$theKey"
}

function commit-if-necessary() {
  if [[ $#@ -lt 1 ]]; then
    fatal-error "Missing commit message?!"
  fi

  local -r commitMessage="$1"

  if ! isTrue "$doCommit"; then
    return 0
  fi

  cd "$repoRootDir"

  local -a targetFilePaths=()
  local aPath
  for aPath in $gitHubActionsFilePaths $allDockerfilePaths; do
    if [[ "$aPath" = "${repoRootDir}"* ]]; then
      targetFilePaths=($targetFilePaths ${aPath#${repoRootDir}/})
    else
      targetFilePaths=($targetFilePaths $aPath)
    fi
  done

  declare gitStatus=""
  gitStatus=$(git status --short $targetFilePaths)

  if [[ -z "$gitStatus" ]]; then
    view-note "Nothing to commit."
    return 0
  fi

  declare -r uDate=$(date '+%Y/%m/%d %H:%M:%S%z')
  set -x
  git add $targetFilePaths
  git commit --message "$commitMessage"$'\n\n'"(Committed by script at ${uDate}.)"
  { set +x; } 2>/dev/null
}

function __update-version() {
  local -r softwareName="$1"
  local -r softwareVersionKey="$2"
  local -r repoURL="$3"
  local -r expectedVersionPattern="${4:-.+}"

  local -r matchedRemoteTags=$(tags-of-remote-repository "$repoURL" | grep -E "$expectedVersionPattern")
  if [[ -z "$matchedRemoteTags" ]]; then
    view-error "No matched tags found for ${softwareName}."
    return 1
  fi

  local -r latestVersionTag=$(latest-version-tag "$matchedRemoteTags")
  if [[ -z "$latestVersionTag" ]]; then
    view-error "Failed to determine the latest version of ${softwareName}."
    return 1
  fi

  replace-value-for-key-in-all-files "$latestVersionTag" "$softwareVersionKey"
  commit-if-necessary "Bump version of ${softwareName} to ${latestVersionTag}."
}

# Commands
###############

function update-apr-version() {
  __update-version \
    "Apache Portable Runtime Library (APR)" \
    APACHE_APR_VERSION \
    https://github.com/apache/apr.git \
    '^[0-9]+(\.[0-9]+(\.[0-9]+)?)?$'
}

function update-apr-util-version() {
  __update-version \
    "Apache Portable Runtime Utility Library" \
    APACHE_APRUTIL_VERSION \
    https://github.com/apache/apr-util.git \
    '^[0-9]+(\.[0-9]+(\.[0-9]+)?)?$'
}

function update-httpd-version() {
  __update-version \
    "Apache HTTP Server" \
    APACHE_HTTP_SERVER_VERSION \
    https://github.com/apache/httpd.git \
    '^2\.4\.[0-9]+$'
}

function update-lua-version() {
  local -r latestLuaInfo="$("$toolsDir"/lua-source-checksum --latest)"
  if [[ "$latestLuaInfo" =~ ^lua-([0-9]+(\.[0-9]+(\.[0-9]+)?)?)\.tar\.gz[[:space:]]+([0-9A-Fa-f]+)$ ]]; then
    local -r latestVersion="${match[1]}"
    local -r latestHash="${match[-1]}"

    replace-value-for-key-in-all-files "$latestVersion" LUA_VERSION
    replace-value-for-key-in-all-files "$latestHash" LUA_HASH
    commit-if-necessary "Bump Lua version to ${latestVersion}."
  else
    view-error "Failed to get the latest version of Lua."
    return 1
  fi
}

case "$commandName" in
update-apr-version | \
update-apr-util-version | \
update-httpd-version | \
update-lua-version)
  $commandName $commandArguments
  ;;
*)
  echo "Unexpected command name: ${commandName}" >&2
  exit 1
;;
esac